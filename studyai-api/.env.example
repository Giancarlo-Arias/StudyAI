# ==========================================
# CONFIGURACIÓN GENERAL DE STUDYAI
# ==========================================

# Nombre de la API
APP_NAME="StudyAI API - Development"

# Versión actual de la aplicación
APP_VERSION="0.1.0"

# Activa o desactiva el modo de depuración
DEBUG=false

# Frontends autorizados para comunicarse con FastAPI
CORS_ORIGINS='["http://localhost:5173","http://127.0.0.1:5173"]'


# ==========================================
# CONEXIÓN A POSTGRESQL
# ==========================================

# Dirección del servidor PostgreSQL
# 127.0.0.1 significa nuestra computadora
DB_HOST=127.0.0.1

# Puerto de PostgreSQL expuesto por Docker
DB_PORT=5433

# Nombre de la base de datos
DB_NAME=studyai_db

# Usuario utilizado para conectarse
DB_USER=studyai

# Contraseña de ejemplo (nunca colocar la real aquí)
DB_PASSWORD="your_local_password"